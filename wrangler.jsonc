{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forme-studio",
  // לא `.open-next/worker.js` ישירות אלא העטיפה שלו: הכניסה ש-OpenNext מייצרת
  // מייצאת `fetch` בלבד, ואין בה איפה לתלות את המתזמן למטה. ראה worker-entry.js.
  "main": "worker-entry.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // הדומיין המותאם — wrangler יוצר את רשומות ה-DNS + התעודות אוטומטית בדיפלוי.
  // דורש שה-CLOUDFLARE_API_TOKEN יכלול Zone·Workers-Routes·Edit + Zone·DNS·Edit
  // עבור aperta-designs.com. הקנוניקל הוא aperta-designs.com (SITE.url).
  //
  // הדומיין הישן (rmjewel.com) אינו כאן במכוון: התוכנית הייתה שימשיך לחיות
  // מחוץ ל-Worker עם 301 לחדש — קישורי שיתוף שנשלחו בוואטסאפ ומיילים שכבר יצאו
  // מצביעים אליו.
  //
  // **נכון ל-9.8 זה לא קרה.** ה-zone עדיין על Cloudflare (`elias`/`shubhi`
  // .ns.cloudflare.com) אבל אין בו רשומת A/AAAA: שאילתה מחזירה NOERROR עם
  // תשובה ריקה. כלומר אין 301, יש דומיין שלא נפתר — וכל
  // `rmjewel.com/d/<token>` שנשלח בוואטסאפ מת. זו פעולת DNS בלוח הבקרה, לא
  // שורה בקובץ הזה (docs/SITE_AUDIT_2026-08.md §7, §10).
  "routes": [
    { "pattern": "aperta-designs.com", "custom_domain": true },
    { "pattern": "www.aperta-designs.com", "custom_domain": true }
  ],
  // מסגור המועמדים רץ ב-Worker נפרד (wrangler.frame.jsonc). לא בשביל מקביליות
  // אלא בשביל תקציב: תקרת ה-128MB היא לכל isolate ומשותפת לכל הבקשות שרצות בו,
  // ו-script אחר הוא isolate אחר. הפריסה חייבת לעלות בסדר הזה — forme-frame
  // קודם, אחרת אין למה לקשור. אם ה-binding חסר, הקוד נופל למסגור מקומי.
  "services": [{ "binding": "FRAME", "service": "forme-frame" }],

  // הסריקה שמסיימת הרצות תקועות. עברה לכאן מ-GitHub Actions, ששם `*/10` נמסר
  // בפועל כפעם בשעה (מרווחים של 50–108 דקות ב-12 ההרצות שקדמו ל-13.8) —
  // והמחיר היה לקוח מול מסך טעינה 11.5 דקות. Cron Trigger יורה בזמן.
  //
  // **מה זה עולה:** 144 הפעלות ביום, ~4,380 בחודש — 0.04% ממכסת ה-10M של
  // Workers Paid, שהחשבון ממילא נמצא בו (service binding ו-maxDuration של
  // 300ש׳ שניהם דורשים אותו). סבב שמוצא טבלה ריקה הוא שאילתה אחת, וסבב שמוצא
  // עבודה עושה בדיוק את מה שהמתזמן הקודם עשה. התוספת האמיתית היא אפס.
  // והשני: ניקוי יומן היצירות מהרצות הקנרית שהסתיימו בטוב. כל שעתיים, בקצב
  // של הקנרית עצמה (`canary.yml`) — כלומר שורה, לכל היותר שתיים, לסבב.
  // דקה 41 ולא 0: `*/10` יורה על עשרות עגולות, ושני מתזמנים שנוחתים באותה
  // דקה מתחרים על אותו isolate בלי שום צורך. איזה מתזמן ירה נקבע לפי
  // `event.cron` — ראה worker-entry.js.
  "triggers": {
    "crons": ["*/10 * * * *", "41 */2 * * *"]
  },

  "observability": {
    "enabled": true
  }
  // Runtime secrets (set via `wrangler secret put` or the deploy workflow):
  //   ANTHROPIC_API_KEY, OPENAI_KEY, SUPABASE_URL, SUPABASE_SECRET_KEY,
  //   LLM_MODEL, OPENAI_MODEL, LLM_PROVIDER
  //   ADMIN_TOKEN — shared secret (>=8 chars) that gates /admin (site inquiries).
  //                 Without it, /admin is disabled; the public order form still works.
}
